################################################################################
# particles emitted from box face towards cylinder
# Note:
#  - The "comm/sort” option to the “global” command is used to match MPI runs.
#  - The “twopass” option is used to match Kokkos runs.
# The "comm/sort" and "twopass" options should not be used for production runs.
################################################################################

# Redirect log output to a custom file
log h200.log

restart 1000 restart/flow.%.1 restart/flow.%.2



# Set up random seed for reproducibility
seed                12345
#package kokkos gpu/aware yes
dimension           3

units               si
global              gridcut 3.0 comm/style neigh

boundary            os oo oo
global              surfmax 50000



# Define the simulation box to fit the geometry

create_box          -20 10.0 -50 50 -50 50

# Balance the grid and set up ghost cells after creating particles
create_grid         200 200 200 
balance_grid        rcb part


# Global settings

global               mem/limit 2000
global               fnum 8e15 temp 300 

 
# Remove this line because the surfaces and particles are already restored from the restart file
#read_surf updated_exitnew2.surf custom mynrho float 0 custom mytemp float 0 custom mystream float 0
read_surf                LMD3DCInlet.surf
#read_surf                landingsurface.surf

region             LP block -0.01 0.1 -0.9 0.9 -0.9 0.9
group               inlet surf region LP center 

#region              cyl1 cylinder x 0.0 0.0 0.81 -0.61 -0.59 
#group               inner surf region cyl1 center

#region              cyl2 cylinder x 0.0 0.0 0.81 -0.05 0.1 
#region              shell intersect 2 cyl2 cyl1 side in
#group               outer_cylinder surf region shell center

#group outer_cylinder surf region shell rflag center

# Define species (only N2 is used)
species		air.species H2O
 
mixture             air2 H2O nrho 1e22 temp 500 vstream 2872.0 0.0 0.0 
# Particle emission
collide             vss all air.vss 
surf_collide        1 diffuse 350.0 1.0
surf_modify         all collide 1
bound_modify        xhi collide 1
surf_collide        2 vanish
surf_modify         inlet collide 2


fix                 in_in1  emit/surf air2 inlet 


timestep            1e-7


compute           1 grid all all nrho temp usq vsq wsq
fix               1 ave/grid all 1 100 100 c_1[*]

compute           mct lambda/grid f_1[1] f_1[2] tau 
compute           tstep dt/grid all 0.25 0.1 &
                  c_mct f_1[2] f_1[3] f_1[4] f_1[5]
compute           mct3 lambda/grid f_1[1] f_1[2] tau knall

